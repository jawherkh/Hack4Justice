{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "PORT",
    "WEB_ORIGIN",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_BUCKET",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_OCR_ENDPOINT",
    "DEEPSEEK_OCR_MODEL",
    "GRAPHITI_URL",
    "LOG_LEVEL",
    "ADMIN_ORIGIN",
    "ADMIN_AUTH_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".tanstack/**",
        ".nitro/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    }
  }
}
