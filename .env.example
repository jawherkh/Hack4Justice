# Shared local defaults. Copy to .env and adjust as needed:
# cp .env.example .env
#
# Never commit .env or place real API keys in this template.
# Package-level .env files override these.
# See apps/api/.env.example and apps/web/.env.example for package vars.
PORT=3001
WEB_ORIGIN=http://localhost:3000

# API local preview
NODE_ENV=
DEMO_ACCESS_ENABLED=
DOCUMENT_STORAGE_DIR=
DEEPSEEK_API_KEY=
DEEPSEEK_OCR_MODEL=
EXTRACTION_STORAGE_DIR=

# API persistence and authentication
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hack4justice
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://localhost:3001

# Graphiti knowledge service
# Required for ingestion and search. Get this from Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# GOOGLE_API_KEY can be used instead of GEMINI_API_KEY.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Gemini roles used by Graphiti
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_SMALL_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1024

# Graphiti service
GRAPHITI_HOST=0.0.0.0
GRAPHITI_PORT=8010
GRAPHITI_STARTUP_CONNECT=false
GRAPHITI_UPDATE_COMMUNITIES=false
GRAPHITI_MAX_COROUTINES=10
GRAPHITI_MAX_TEXT_CHARS=12000
GRAPHITI_CHUNK_OVERLAP_CHARS=400
GRAPHITI_CORS_ORIGINS=http://localhost:3000
