# ─────────────────────────────────────────────────────────────
#  hack4justice – environment variable reference
#  Copy this file to .env and fill in values for your machine.
#  NEVER commit .env to version control.
#
#  Package-level overrides: apps/api/.env.example, apps/web/.env.example
# ─────────────────────────────────────────────────────────────

# ── Monorepo apps (apps/api, apps/web) ────────────────────────
PORT=3001
WEB_ORIGIN=http://localhost:3000

# ── TypeScript web API backend (Backend/) ─────────────────────
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# ── PostgreSQL (app database) ─────────────────────────────────
POSTGRES_USER=h4j
POSTGRES_PASSWORD=change_me
POSTGRES_DB=h4j_dev
DATABASE_URL=postgresql://h4j:change_me@localhost:5432/h4j_dev

# ── MinIO (local S3-compatible file storage) ──────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=h4jadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_SANDBOX=sandbox-artifacts
# Web console: http://localhost:9001

# ── Temporal ──────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Web UI: http://localhost:8088

# ── Temporal task queue names ─────────────────────────────────
#  Shared by TS (Backend/) and Python (agent/) services.
QUEUE_GRAPH_INGESTION=graph-ingestion
QUEUE_DOSSIER_ORCHESTRATION=dossier-orchestration
QUEUE_SANDBOX_EXECUTION=sandbox-execution

# ── Python agent (agent/) ─────────────────────────────────────
# Neo4j / Graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# Browser console: http://localhost:7474

# OpenAI – used by Graphiti for entity/relationship extraction
OPENAI_API_KEY=sk-change_me
OPENAI_MODEL=gpt-4o-mini

# ── Service URLs (reference) ──────────────────────────────────
SERVICE_API_URL=http://localhost:3000
SERVICE_TEMPORAL_UI_URL=http://localhost:8088
SERVICE_NEO4J_BROWSER_URL=http://localhost:7474
SERVICE_MINIO_CONSOLE_URL=http://localhost:9001
