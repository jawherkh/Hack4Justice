# Single shared env file for the whole monorepo. Copy to .env at the repo root.
#   - apps/api loads it in src/env.ts (dotenv)
#   - apps/web (Vite) reads it via `envDir`; only VITE_* keys reach the browser
#   - packages/db (drizzle-kit) and packages/auth (CLI) read it directly

# --- API -------------------------------------------------------------------
PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database (docker compose: db) -------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hack4justice

# --- Auth (Better Auth). Generate the secret with: openssl rand -base64 32 --
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://localhost:3001

# --- Object storage (docker compose: minio) ----------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=hack4justice

# --- Text extraction ----------------------------------------------------------
# Native PDF text is read with Poppler; scanned pages are sent to this
# OpenAI-compatible DeepSeek Flash OCR endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_OCR_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_OCR_MODEL=deepseek-flash
GRAPHITI_URL=http://localhost:8010

# --- Web (browser-exposed, must be prefixed VITE_) ---------------------------
VITE_API_URL=http://localhost:3001
# Graphiti knowledge service
# Required for ingestion and search. Get this from Google AI Studio.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# GOOGLE_API_KEY can be used instead of GEMINI_API_KEY.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Gemini roles used by Graphiti
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_SMALL_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=1024

# Graphiti service
GRAPHITI_HOST=0.0.0.0
GRAPHITI_PORT=8010
GRAPHITI_STARTUP_CONNECT=false
GRAPHITI_UPDATE_COMMUNITIES=false
GRAPHITI_MAX_COROUTINES=10
# Chonkie SentenceChunker settings. With the character tokenizer these are
# character budgets; sentence boundaries are preserved before overlap is added.
GRAPHITI_MAX_TEXT_CHARS=12000
GRAPHITI_CHUNK_OVERLAP_CHARS=400
GRAPHITI_CORS_ORIGINS=http://localhost:3000

# --- Temporal workflow worker (optional for the API; required for durable lifecycle execution) ---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=dossier-lifecycle

# --- Principal Gemini assistant through the OpenAI Agents SDK (optional) ------
# The same key can also be used by Graphiti above.
AGENT_MODEL=gemini-2.5-flash
GEMINI_AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SANDBOX_IMAGE=alpine:3.20
SANDBOX_BASE_DIR=.local-data/agent-sandboxes

# --- Outbound SMS and WhatsApp delivery --------------------------------------
# Leave empty to record messages as simulated; the API still runs and the body
# is stored and displayed. A WhatsApp sandbox sender cannot send SMS, so the two
# senders are configured separately.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
