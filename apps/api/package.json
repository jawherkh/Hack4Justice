{
  "name": "@hack4justice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "worker": "tsx src/lifecycle/worker.ts",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:storage": "tsx scripts/test-storage.ts",
    "db:init": "tsx scripts/init-storage.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.16",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@hack4justice/auth": "workspace:*",
    "@hack4justice/db": "workspace:*",
    "@hack4justice/logger": "workspace:*",
    "@hack4justice/shared": "workspace:*",
    "@hack4justice/storage": "workspace:*",
    "@openai/agents": "^0.18.0",
    "@t3-oss/env-core": "^0.13.11",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "marked": "^18.0.12",
    "openai": "^7.2.0",
    "pdfkit": "^0.20.2",
    "postgres": "3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@hack4justice/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./app": "./src/index.ts"
