{
  "name": "@hack4justice/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\" && exit 0",
    "test": "vitest run",
    "test:storage": "bun scripts/test-storage.ts",
    "db:init": "bun scripts/init-storage.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.16",
    "@hack4justice/auth": "workspace:*",
    "@hack4justice/db": "workspace:*",
    "@hack4justice/logger": "workspace:*",
    "@hack4justice/shared": "workspace:*",
    "@hack4justice/storage": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "postgres": "3.4.9",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@hack4justice/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0"
  },
  "exports": {
    "./app": "./src/index.ts"
  }
