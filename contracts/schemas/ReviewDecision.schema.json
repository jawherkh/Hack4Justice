      "title": "Evidence Ids",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "dossier_id",
    "node_id",
    "id",
    "agency",
    "actor",
    "action",
    "reason",
    "dossier_version",
    "procedure_version_id",
    "evidence_ids",
    "created_at",
    "idempotency_key"
