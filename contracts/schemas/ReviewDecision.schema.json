{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "business_member",
            "officer",
            "rule_maintainer",
            "service"
          ],
          "title": "Kind",
          "type": "string"
        },
        "agency": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgencyCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AgencyCode": {
      "enum": [
        "DGI",
        "RNE",
        "APII"
      ],
      "title": "AgencyCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "dossier_id": {
      "format": "uuid",
      "title": "Dossier Id",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "agency": {
      "$ref": "#/$defs/AgencyCode"
    },
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "action": {
      "enum": [
        "accept",
        "refuse",
        "request_modification"
