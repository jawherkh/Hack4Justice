      "title": "Action",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "dossier_version": {
      "minimum": 1,
      "title": "Dossier Version",
      "type": "integer"
    },
    "procedure_version_id": {
      "format": "uuid",
      "title": "Procedure Version Id",
      "type": "string"
    },
    "evidence_ids": {
