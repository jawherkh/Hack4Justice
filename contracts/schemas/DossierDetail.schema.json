          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
