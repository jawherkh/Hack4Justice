{
  "$defs": {
    "Action": {
      "enum": [
        "view",
        "edit_facts",
        "upload_evidence",
        "correct_evidence",
        "request_review",
        "prepare_document",
        "run_validation",
        "record_decision",
        "execute_external",
        "submit",
        "resubmit",
        "cancel"
