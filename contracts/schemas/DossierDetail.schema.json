      "title": "Actor",
      "type": "object"
    },
    "AgencyAcceptance": {
      "enum": [
        "not_submitted",
        "pending",
        "modification_requested",
        "accepted",
        "refused"
      ],
      "title": "AgencyAcceptance",
      "type": "string"
    },
    "AgencyCode": {
      "enum": [
        "DGI",
        "RNE",
        "APII"
      ],
