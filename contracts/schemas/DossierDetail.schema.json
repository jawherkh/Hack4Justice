    "Dossier": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "company_id": {
          "format": "uuid",
          "title": "Company Id",
          "type": "string"
        },
        "agency": {
          "$ref": "#/$defs/AgencyCode"
