{
  "$defs": {
    "Action": {
      "enum": [
        "view",
        "edit_facts",
        "upload_evidence",
        "correct_evidence",
        "request_review",
        "prepare_document",
        "run_validation",
        "record_decision",
        "execute_external",
        "submit",
        "resubmit",
        "cancel"
      ],
      "title": "Action",
      "type": "string"
    },
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "business_member",
            "officer",
            "rule_maintainer",
            "service"
          ],
          "title": "Kind",
          "type": "string"
        },
        "agency": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgencyCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AgencyAcceptance": {
      "enum": [
        "not_submitted",
        "pending",
        "modification_requested",
        "accepted",
        "refused"
      ],
      "title": "AgencyAcceptance",
      "type": "string"
    },
    "AgencyCode": {
      "enum": [
        "DGI",
        "RNE",
        "APII"
      ],
      "title": "AgencyCode",
      "type": "string"
    },
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "format": "uuid",
          "title": "Obligation Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "submit",
            "resubmit",
            "execute_external"
          ],
          "title": "Action",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrerequisiteStatus"
        },
        "dependency_verification": {
          "enum": [
            "verified",
            "synthetic"
          ],
          "title": "Dependency Verification",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "obligation_id",
        "action",
        "status",
        "dependency_verification",
        "reason",
        "source"
      ],
      "title": "Blocker",
      "type": "object"
    },
    "NodeState": {
      "enum": [
        "not_started",
        "in_progress",
        "waiting",
        "needs_correction",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ],
      "title": "NodeState",
      "type": "string"
    },
    "NodeType": {
      "enum": [
        "information_input",
        "document_evidence",
        "document_preparation",
        "validation",
        "decision",
        "external_action",
        "human_review",
        "submission"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "PrerequisiteStatus": {
      "enum": [
        "unknown",
        "satisfied",
        "unsatisfied",
        "not_applicable"
      ],
      "title": "PrerequisiteStatus",
      "type": "string"
    },
    "Readiness": {
      "enum": [
        "unknown",
        "incomplete",
        "needs_review",
        "ready"
      ],
      "title": "Readiness",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official",
            "synthetic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "passage": {
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "passage",
        "sha256",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "dossier_id": {
      "format": "uuid",
      "title": "Dossier Id",
      "type": "string"
    },
    "node_id": {
      "format": "uuid",
      "title": "Node Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "procedure_version_id": {
      "format": "uuid",
      "title": "Procedure Version Id",
      "type": "string"
    },
    "agency": {
      "$ref": "#/$defs/AgencyCode"
    },
    "type": {
      "$ref": "#/$defs/NodeType"
    },
    "state": {
      "$ref": "#/$defs/NodeState"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "content": {
      "default": "",
      "title": "Content",
      "type": "string"
    },
    "responsible_actor": {
      "$ref": "#/$defs/Actor"
    },
    "dependencies": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "requirement_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Requirement Ids",
      "type": "array"
    },
    "finding_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "allowed_actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/Blocker"
      },
      "title": "Blockers",
      "type": "array"
    },
    "readiness": {
      "$ref": "#/$defs/Readiness",
      "default": "unknown"
    },
    "agency_acceptance": {
      "$ref": "#/$defs/AgencyAcceptance",
      "default": "not_submitted"
    },
    "prerequisite_status": {
      "$ref": "#/$defs/PrerequisiteStatus",
      "default": "unknown"
    }
  },
  "required": [
    "company_id",
    "dossier_id",
    "node_id",
    "version",
    "procedure_version_id",
    "agency",
    "type",
    "state",
    "title",
    "responsible_actor"
  ],
  "title": "Node",
  "type": "object"
}
