{
  "$defs": {
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "obligation_id": {
          "format": "uuid",
          "title": "Obligation Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "submit",
            "resubmit",
            "execute_external"
          ],
          "title": "Action",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/PrerequisiteStatus"
        },
        "dependency_verification": {
          "enum": [
            "verified",
            "synthetic"
          ],
          "title": "Dependency Verification",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "obligation_id",
        "action",
        "status",
        "dependency_verification",
        "reason",
        "source"
      ],
      "title": "Blocker",
      "type": "object"
    },
    "PrerequisiteStatus": {
      "enum": [
        "unknown",
        "satisfied",
        "unsatisfied",
        "not_applicable"
      ],
      "title": "PrerequisiteStatus",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official",
            "synthetic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "passage": {
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "passage",
        "sha256",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "code": {
      "enum": [
        "validation_error",
        "forbidden",
        "not_found",
        "version_conflict",
        "idempotency_conflict",
        "action_blocked",
        "not_implemented"
      ],
      "title": "Code",
      "type": "string"
    },
    "message": {
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "current_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Version"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/Blocker"
      },
      "title": "Blockers",
      "type": "array"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorResponse",
  "type": "object"
}
