{
  "source": "basé sur la description de projet fournie, je veux.pdf",
  "scope_note": "These decision trees are derived only from the uploaded document. Where the document is silent, the JSON does not invent a rule.",
  "entities": [
    {
      "entity_id": "APII",
      "entity_name": "Agence de Promotion de l'Industrie et de l'Innovation",
      "services": [
        {
          "service_id": "APII_INVESTMENT_DECLARATION",
          "name": "Déclaration de projet d'investissement",
          "submission": [
            "physical_guichet_unique",
            "online_portal"
          ],
          "outputs": [
            "attestation_de_depot",
            "internal_APII_record"
          ],
          "decision_tree": {
            "start": {
              "question": "Le profil du demandeur est-il éligible au canal électronique disponible ?",
              "if_yes": "prepare_online_submission",
              "if_no_or_not_supported": "physical_submission"
            },
            "prepare_online_submission": {
              "action": "prepare_and_submit_project_declaration",
              "next": "APII_review"
            },
            "physical_submission": {
              "action": "submit_at_guichet_unique",
              "next": "APII_review"
            },
            "APII_review": {
              "question": "Le dossier est-il recevable et complet ?",
              "if_yes": "issue_attestation",
              "if_no": "request_correction_or_reject"
            },
            "issue_attestation": {
              "outputs": [
                "attestation_de_depot"
              ],
              "downstream": [
                "constitution",
                "certains_avantages"
              ]
            },
            "request_correction_or_reject": {
              "status": "blocked_until_correction"
            }
          },
          "automation": {
            "preparation": true,
            "pre_validation": true,
            "official_submission": "depends_on_profile_and_available_portal",
            "direct_cross_agency_api": false
          }
        },
        {
          "service_id": "APII_COMPANY_CONSTITUTION",
          "name": "Constitution entreprise individuelle / SARL / SUARL",
          "submission": [
            "physical",
            "online_for_some_cases"
          ],
          "outputs": [
            "fiscal_identification_card",
            "registered_acts",
            "RC_registration",
            "JORT_publication",
            "extracts"
          ],
          "decision_tree": {
            "start": {
              "question": "Le dossier peut-il utiliser le guichet unique virtuel ?",
              "if_yes": "electronic_constitution",
              "if_no": "physical_guichet_unique"
            },
            "electronic_constitution": {
              "action": "submit_electronic_declaration_and_scanned_documents",
              "next": "multi_office_validation"
            },
            "physical_guichet_unique": {
              "action": "submit_to_intervening_offices",
              "next": "multi_office_validation"
            },
            "multi_office_validation": {
              "question": "Les exigences des bureaux intervenants sont-elles satisfaites ?",
              "if_yes": "complete_registration_chain",
              "if_no": "correction_or_delay"
            },
            "complete_registration_chain": {
              "offices": [
                "DGI",
                "Greffe",
                "JORT"
              ],
              "outputs": [
                "fiscal_card",
                "RC",
                "JORT_publication"
              ]
            },
            "correction_or_delay": {
              "impact": [
                "delayed_RC",
                "delayed_RNE_progression",
                "delayed_downstream_services"
              ]
            }
          },
          "automation": {
            "preparation": true,
            "pre_validation": true,
            "official_submission": "not_universally_automated",
            "interoperability": "partly_human_back_office"
          }
        }
      ]
    },
    {
      "entity_id": "RNE",
      "entity_name": "Registre National des Entreprises",
      "services": [
        {
          "service_id": "RNE_REGISTRATION",
          "name": "Immatriculation entreprise",
          "submission": [
            "100_percent_online"
          ],
          "authentication": [
            "MobileID_for_physical_persons",
            "DigiGo_for_legal_persons"
          ],
          "outputs": [
            "RNE_identifier",
            "certified_digital_extract"
          ],
          "decision_tree": {
            "start": {
              "question": "Les données d'identité et de l'entreprise sont-elles cohérentes et complètes ?",
              "if_yes": "authenticate",
              "if_no": "correct_data"
            },
            "authenticate": {
              "question": "L'authentification requise est-elle disponible ?",
              "if_yes": "submit",
              "if_no": "authentication_block"
            },
            "submit": {
              "action": "official_RNE_submission",
              "next": "RNE_validation"
            },
            "RNE_validation": {
              "question": "RNE accepte-t-il le dossier ?",
              "if_yes": "issue_identifier_and_extract",
              "if_no": "rejection"
            },
            "rejection": {
              "reasons": [
                "incomplete_documents",
                "inconsistent_data",
                "non_compliant_name"
              ],
              "impact": [
                "CNSS_affiliation_may_be_blocked",
                "DGI_procedures_may_be_delayed"
              ]
            }
          },
          "automation": {
            "preparation": true,
            "pre_validation": true,
            "official_submission": true,
            "workflow": "fully_digital",
            "direct_cross_agency_api": "not_established_in_source"
          }
        },
        {
          "service_id": "RNE_UPDATE",
          "name": "Mise à jour des données",
          "submission": [
            "online"
          ],
          "authentication": [
            "MobileID",
            "DigiGo"
          ],
          "outputs": [
            "updated_certified_extract",
            "digital_notification"
          ],
          "decision_tree": {
            "start": {
              "question": "Les données modifiées et justificatifs sont-ils conformes ?",
              "if_yes": "submit_update",
              "if_no": "request_correction"
            },
            "submit_update": {
              "action": "submit_online",
              "next": "RNE_validation"
            },
            "RNE_validation": {
              "question": "La mise à jour est-elle acceptée ?",
              "if_yes": "update_record",
              "if_no": "keep_previous_state"
            },
            "keep_previous_state": {
              "impact": [
                "CNSS_or_DGI_data_inconsistency"
              ]
            }
          }
        },
        {
          "service_id": "RNE_DEREGISTRATION",
          "name": "Radiation / fermeture",
          "submission": [
            "online"
          ],
          "outputs": [
            "digital_radiation_certificate"
          ],
          "decision_tree": {
            "start": {
              "question": "Les actes et pièces respectent-ils les exigences de signature et de forme ?",
              "if_yes": "submit_deregistration",
              "if_no": "request_compliant_documents"
            },
            "submit_deregistration": {
              "action": "official_RNE_submission",
              "next": "RNE_validation"
            },
            "RNE_validation": {
              "question": "La radiation est-elle acceptée ?",
              "if_yes": "record_radiation",
              "if_no": "correction_or_rejection"
            },
            "record_radiation": {
              "impact": [
                "possible_Cnss_DGI_misalignment_if_not_aligned"
              ]
            }
          }
        },
        {
          "service_id": "RNE_ELECTRONIC_SAFE",
          "name": "Coffre-fort électronique",
          "submission": [
            "initial_activation_often_physical",
            "then_online"
          ],
          "outputs": [
            "certified_electronic_acts",
            "timestamped_documents"
          ],
          "decision_tree": {
            "start": {
              "question": "Le coffre-fort est-il activé ?",
              "if_yes": "online_use",
              "if_no": "initial_activation"
            },
            "initial_activation": {
              "action": "activation_once_with_OTP",
              "next": "online_use"
            },
            "online_use": {
              "action": "deposit_and_retrieve_certified_electronic_documents"
            }
          }
        }
      ]
    },
    {
      "entity_id": "DGI",
      "entity_name": "Direction Générale des Impôts",
      "services": [
        {
          "service_id": "DGI_MONTHLY_DECLARATION",
          "name": "Déclaration fiscale mensuelle",
          "submission": [
            "online_e_Jibaya"
          ],
          "authentication": [
            "telesubscriber_identifier",
            "DIGIGO_certificate"
          ],
          "outputs": [
            "acknowledgement",
            "amount_due",
            "payment_receipt"
          ],
          "decision_tree": {
            "start": {
              "question": "L'entreprise est-elle adhérente et correctement identifiée sur e-Jibaya ?",
              "if_yes": "prepare_declaration",
              "if_no": "complete_enrollment"
            },
            "prepare_declaration": {
              "question": "Calculs et fichier sont-ils cohérents/conformes ?",
              "if_yes": "submit",
              "if_no": "correct_before_submission"
            },
            "submit": {
              "action": "official_e_Jibaya_submission",
              "next": "DGI_validation"
            },
            "DGI_validation": {
              "question": "La déclaration est-elle acceptée ?",
              "if_yes": "issue_receipt_and_amount_due",
              "if_no": "rejection"
            },
            "rejection": {
              "impact": [
                "TEJ_irregular_status",
                "possible_penalties",
                "possible_downstream_regularization"
              ]
            }
          }
        },
        {
          "service_id": "DGI_ANNUAL_RETURN",
          "name": "Déclaration annuelle de résultats / liasse fiscale",
          "submission": [
            "online_e_Liasse"
          ],
          "outputs": [
            "timestamped_electronic_receipt"
          ],
          "decision_tree": {
            "start": {
              "question": "La liasse est-elle complète et signée électroniquement ?",
              "if_yes": "submit",
              "if_no": "correct"
            },
            "submit": {
              "action": "official_e_Liasse_submission",
              "next": "DGI_validation"
            },
            "DGI_validation": {
              "question": "Acceptée ?",
              "if_yes": "receipt",
              "if_no": "rejection"
            }
          }
        },
        {
          "service_id": "DGI_TEJ",
          "name": "Consultation situation fiscale / certificats",
          "submission": [
            "online"
          ],
          "authentication": [
            "login",
            "certificate"
          ],
          "outputs": [
            "tax_status",
            "withholding_certificates",
            "electronic_attestations"
          ],
          "decision_tree": {
            "start": {
              "question": "Le compte/adhésion requis est-il disponible ?",
              "if_yes": "consult",
              "if_no": "enroll"
            },
            "consult": {
              "question": "La situation fiscale est-elle régulière ?",
              "if_yes": "provide_status_or_certificate",
              "if_no": "show_irregularity"
            },
            "show_irregularity": {
              "impact": [
                "supplier_exclusion_risk_for_public_enterprises"
              ]
            }
          }
        }
      ]
    },
    {
      "entity_id": "CNSS",
      "entity_name": "Caisse Nationale de Sécurité Sociale",
      "services": [
        {
          "service_id": "CNSS_EMPLOYER_AFFILIATION",
          "name": "Affiliation employeur / création compte",
          "submission": [
            "regional_office",
            "online",
            "often_hybrid_initial_activation"
          ],
          "inputs": [
            "RNE_extract",
            "manager_CIN",
            "statutes",
            "tax_id",
            "initial_employment_contracts"
          ],
          "outputs": [
            "CNSS_employer_number",
            "employer_online_space"
          ],
          "decision_tree": {
            "start": {
              "question": "Les données RNE et fiscales nécessaires sont-elles disponibles ?",
              "if_yes": "submit_affiliation",
              "if_no": "block_and_request_missing_data"
            },
            "submit_affiliation": {
              "question": "Le dossier est-il accepté ?",
              "if_yes": "activate_employer_account",
              "if_no": "rejection"
            },
            "rejection": {
              "reasons": [
                "missing_RNE_data",
                "missing_tax_id"
              ],
              "impact": [
                "cannot_file_salaries",
                "cannot_obtain_attestations"
              ]
            }
          }
        },
        {
          "service_id": "CNSS_EMPLOYEE_REGISTRATION",
          "name": "Immatriculation salariés",
          "submission": [
            "online",
            "sometimes_paper"
          ],
          "outputs": [
            "individual_registration_numbers",
            "summary_statement",
            "receipts"
          ],
          "decision_tree": {
            "start": {
              "question": "Les données employeur et salariés sont-elles cohérentes ?",
              "if_yes": "submit",
              "if_no": "correct"
            },
            "submit": {
              "action": "online_employee_registration",
              "next": "CNSS_validation"
            },
            "CNSS_validation": {
              "question": "Le fichier est-il accepté ?",
              "if_yes": "issue_registration_numbers",
              "if_no": "request_correction"
            }
          }
        },
        {
          "service_id": "CNSS_QUARTERLY_DECLARATION",
          "name": "Déclaration trimestrielle des salaires et télépaiement",
          "submission": [
            "online_e_Teleservices"
          ],
          "outputs": [
            "electronic_acknowledgement",
            "balance_certificate"
          ],
          "decision_tree": {
            "start": {
              "question": "Le fichier salarial est-il complet et les numéros CNSS valides ?",
              "if_yes": "submit_and_pay",
              "if_no": "correct"
            },
            "submit_and_pay": {
              "action": "file_declaration_and_make_payment",
              "next": "CNSS_processing"
            },
            "CNSS_processing": {
              "question": "Déclaration acceptée et paiement traité ?",
              "if_yes": "issue_attestation",
              "if_no": "rejection_or_penalty"
            },
            "rejection_or_penalty": {
              "impact": [
                "attestation_unavailable",
                "public_procurement_impact",
                "APII_advantage_or_project_impact_possible"
              ]
            }
          }
        }
      ]
    },
    {
      "entity_id": "GREFFE",
      "entity_name": "Greffe du tribunal",
      "services": [
        {
          "service_id": "GREFFE_COMPANY_ACTS",
          "name": "Dépôt / enregistrement des actes et immatriculation RC",
          "submission": [
            "physical",
            "participates_in_virtual_APII_chain_for_some_cases"
          ],
          "outputs": [
            "registered_acts",
            "RC_registration"
          ],
          "decision_tree": {
            "start": {
              "question": "Les actes et pièces exigés sont-ils complets et conformes ?",
              "if_yes": "register",
              "if_no": "reject_or_request_correction"
            },
            "register": {
              "action": "register_company_acts",
              "next": "JORT_publication"
            },
            "reject_or_request_correction": {
              "impact": [
                "JORT_delay",
                "RC_delay",
                "RNE_delay"
              ]
            }
          },
          "automation": {
            "preparation": true,
            "official_submission": "partially_physical",
            "technical_api_interoperability": "not_established_in_source"
          }
        }
      ]
    },
    {
      "entity_id": "JORT",
      "entity_name": "Journal Officiel de la République Tunisienne",
      "services": [
        {
          "service_id": "JORT_COMPANY_PUBLICATION",
          "name": "Publication des avis / actes liés à la constitution",
          "submission": [
            "through_APII_intervening_chain"
          ],
          "outputs": [
            "JORT_publication"
          ],
          "decision_tree": {
            "start": {
              "question": "Les données et actes nécessaires à la publication sont-ils validés ?",
              "if_yes": "publish",
              "if_no": "return_for_correction"
            },
            "publish": {
              "action": "publish_notice",
              "downstream": [
                "RC_RNE_chain"
              ]
            },
            "return_for_correction": {
              "impact": [
                "delayed_publication",
                "delayed_registration"
              ]
            }
          },
          "automation": {
            "documented_state": "semi_paper",
            "direct_API_interoperability": "not_supported_by_source"
          }
        }
      ]
    },
    {
      "entity_id": "TUNTRUST",
      "entity_name": "TunTrust",
      "services": [
        {
          "service_id": "TUNTRUST_E_SIGNATURE",
          "name": "Certificats / signature électronique",
          "role": "authentication_and_qualified_e_signature",
          "decision_tree": {
            "start": {
              "question": "L'utilisateur dispose-t-il du certificat / mécanisme d'identification requis ?",
              "if_yes": "authenticate_or_sign",
              "if_no": "obtain_or_activate_certificate"
            },
            "authenticate_or_sign": {
              "question": "La signature / authentification est-elle valide ?",
              "if_yes": "allow_downstream_submission",
              "if_no": "authentication_or_signature_failure"
            }
          },
          "legal_note": "The document states that qualified electronic signatures have legal value equivalent to handwritten signatures in covered cases, while certain authentic/legalized acts remain exceptions."
        }
      ]
    },
    {
      "entity_id": "MINISTRIES_AND_SECTORAL_AUTHORITIES",
      "entity_name": "Ministères / autorités sectorielles",
      "services": [
        {
          "service_id": "SECTORAL_PRIOR_AUTHORIZATION",
          "name": "Autorisations sectorielles préalables",
          "submission": [
            "depends_on_sector_and_procedure"
          ],
          "decision_tree": {
            "start": {
              "question": "L'activité nécessite-t-elle une autorisation sectorielle ?",
              "if_yes": "request_authorization",
              "if_no": "continue_main_workflow"
            },
            "request_authorization": {
              "question": "Autorisation obtenue ?",
              "if_yes": "continue_main_workflow",
              "if_no": "block_dependent_APII_or_business_process"
            }
          },
          "source_limit": "The document mentions sectoral authorizations but does not provide a service-by-service decision table for individual ministries."
        }
      ]
    }
  ],
  "cross_entity_dependencies": [
    {
      "from": "APII",
      "event": "constitution_dossier_not_receivable",
      "impacts": [
        "RNE",
        "RC",
        "CNSS",
        "DGI"
      ],
      "effect": "downstream constitution steps delayed or blocked"
    },
    {
      "from": "RNE",
      "event": "registration_or_update_rejected",
      "impacts": [
        "CNSS",
        "DGI"
      ],
      "effect": "identifier/data dependency can block or delay downstream procedures"
    },
    {
      "from": "DGI",
      "event": "tax_registration_rejected_or_missing",
      "impacts": [
        "CNSS",
        "e_Jibaya",
        "TEJ"
      ],
      "effect": "tax identifier unavailable and downstream onboarding/declarations can be blocked"
    },
    {
      "from": "DGI",
      "event": "declaration_rejected_or_missing",
      "impacts": [
        "TEJ",
        "public_supplier_relationships"
      ],
      "effect": "irregular tax status / possible exclusion risk"
    },
    {
      "from": "CNSS",
      "event": "employer_affiliation_rejected",
      "impacts": [
        "CNSS_subsequent_services"
      ],
      "effect": "salary declarations and attestations unavailable"
    },
    {
      "from": "CNSS",
      "event": "quarterly_declaration_rejected_or_late",
      "impacts": [
        "APII_projects_or_advantages",
        "public_procurement"
      ],
      "effect": "attestation unavailable and downstream eligibility/use can be affected"
    }
  ],
  "global_automation_rules": [
    {
      "rule_id": "PREPARE_NOT_SUBMIT",
      "rule": "The automated assistant should distinguish dossier preparation/pre-validation from official submission."
    },
    {
      "rule_id": "NO_UNSUPPORTED_API",
      "rule": "Do not represent an inter-agency API integration unless an official API is established."
    },
    {
      "rule_id": "VALIDATE_BEFORE_PUSH",
      "rule": "Validate completeness and consistency before prompting an official submission to reduce chained rejection."
    },
    {
      "rule_id": "EXPLICIT_STATUS",
      "rule": "Represent NOT_SUBMITTED, SUBMITTED, ACCEPTED, REJECTED and BLOCKED states explicitly."
    },
    {
      "rule_id": "PHYSICAL_EXCEPTION",
      "rule": "Preserve physical/hybrid steps where the source identifies initial activation, identity verification, authentic acts, or administrative practice as physical."
    }
  ]
}