{
  "name": "hack4justice-api",
  "version": "0.1.0",
  "description": "hack4justice – TypeScript web API backend",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/api/index.js",
    "worker:dossier": "tsx src/workers/dossierOrchestrationWorker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "storage:init": "tsx scripts/storageInit.ts",
    "health": "tsx scripts/healthCheck.ts",
    "demo": "tsx scripts/demoFixture.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@temporalio/activity": "1.10.3",
    "@temporalio/client": "1.10.3",
    "@temporalio/worker": "1.10.3",
    "@temporalio/workflow": "1.10.3",
    "@prisma/client": "5.14.0",
    "minio": "8.0.1",
    "express": "4.19.2",
    "zod": "3.23.8",
    "pino": "9.2.0",
    "pino-pretty": "11.2.1",
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "prisma": "5.14.0",
    "tsx": "4.15.7",
    "typescript": "5.4.5",
    "@types/node": "20.14.9",
    "@types/express": "4.17.21",
    "vitest": "1.6.0",
    "eslint": "8.57.0",
    "@typescript-eslint/eslint-plugin": "7.14.1",
    "@typescript-eslint/parser": "7.14.1"
  }
}
