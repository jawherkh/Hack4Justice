// hack4justice – Prisma schema
// App database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Core models ───────────────────────────────────────────────

model Subject {
  id          String    @id @default(cuid())
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dossiers    Dossier[]
}

model Dossier {
  id          String    @id @default(cuid())
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  status      DossierStatus @default(DRAFT)
  exportUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  storageKey  String    @unique
  mimeType    String
  sizeBytes   Int
  graphNodeId String?   // corresponding Neo4j node id
  createdAt   DateTime  @default(now())
}

enum DossierStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
  FAILED
}
