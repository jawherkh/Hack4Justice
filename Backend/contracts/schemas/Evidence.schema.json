{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "business_member",
            "officer",
            "rule_maintainer",
            "service"
          ],
          "title": "Kind",
          "type": "string"
        },
        "agency": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgencyCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AgencyCode": {
      "enum": [
        "DGI",
        "RNE",
        "APII"
      ],
      "title": "AgencyCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "dossier_id": {
      "format": "uuid",
      "title": "Dossier Id",
      "type": "string"
    },
    "node_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Id"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "replaces_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaces Id"
    },
    "requirement_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids",
      "type": "array"
    },
    "storage_ref": {
      "minLength": 1,
      "title": "Storage Ref",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "mime_type": {
      "minLength": 1,
      "title": "Mime Type",
      "type": "string"
    },
    "uploaded_by": {
      "$ref": "#/$defs/Actor"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    },
    "extraction_method": {
      "enum": [
        "native",
        "ocr",
        "mixed",
        "not_processed"
      ],
      "title": "Extraction Method",
      "type": "string"
    },
    "raw_text_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Text Ref"
    },
    "confirmed_fields_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmed Fields Ref"
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "confirmed",
        "needs_correction"
      ],
      "title": "Review Status",
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "dossier_id",
    "id",
    "version",
    "requirement_ids",
    "storage_ref",
    "sha256",
    "mime_type",
    "uploaded_by",
    "uploaded_at",
    "extraction_method",
    "review_status"
  ],
  "title": "Evidence",
  "type": "object"
}
