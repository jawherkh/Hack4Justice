{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official",
            "synthetic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "passage": {
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "passage",
        "sha256",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "procedure_version_id": {
      "format": "uuid",
      "title": "Procedure Version Id",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "evidence_type": {
      "minLength": 1,
      "title": "Evidence Type",
      "type": "string"
    },
    "minimum_count": {
      "default": 1,
      "minimum": 1,
      "title": "Minimum Count",
      "type": "integer"
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unknown"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "id",
    "procedure_version_id",
    "code",
    "description",
    "evidence_type",
    "applicability",
    "sources"
  ],
  "title": "Requirement",
  "type": "object"
}
