{
  "$defs": {
    "AgencyCode": {
      "enum": [
        "DGI",
        "RNE",
        "APII"
      ],
      "title": "AgencyCode",
      "type": "string"
    },
    "PrerequisiteStatus": {
      "enum": [
        "unknown",
        "satisfied",
        "unsatisfied",
        "not_applicable"
      ],
      "title": "PrerequisiteStatus",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "official",
            "synthetic"
          ],
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "passage": {
          "minLength": 1,
          "title": "Passage",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "passage",
        "sha256",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "responsible_agency": {
      "$ref": "#/$defs/AgencyCode"
    },
    "code": {
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PrerequisiteStatus"
    },
    "basis": {
      "enum": [
        "missing_evidence",
        "user_claim",
        "authoritative",
        "simulated"
      ],
      "title": "Basis",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "authoritative_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authoritative Reference"
    }
  },
  "required": [
    "id",
    "company_id",
    "responsible_agency",
    "code",
    "status",
    "basis",
    "observed_at"
  ],
  "title": "ObligationStatus",
  "type": "object"
}
